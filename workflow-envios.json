    {
      "id": "api_track",
      "lane": "api",
      "col": 5,
      "type": "cloud",
      "label": "API Rastreo",
      "sublabel": "consulta pública",
      "width": 132
    },
    {
      "id": "followup",
      "lane": "web",
      "col": 5,
      "type": "frontend",
      "label": "Ver seguimiento",
      "sublabel": "stepper + timeline",
      "width": 190
    },
    {
      "id": "mock",
      "lane": "fallback",
      "col": 3,
      "type": "database",
      "label": "Guías de respaldo",
      "sublabel": "MOCK_TRACKING_DETAILS",
      "width": 150
    }
  ],
  "edges": [
    {
      "id": "crear-create",
      "from": "crear",
      "to": "create_call"
    },
    {
      "id": "create-post",
      "from": "create_call",
      "to": "api_crear",
      "label": "POST /api/v1/packages",
      "variant": "emphasis"
    },
    {
      "id": "create-reply",
      "from": "api_crear",
      "to": "guia",
      "label": "200 trackingCode",
      "variant": "emphasis",
      "role": "return"
    },
    {
      "id": "guia-estado",
      "from": "guia",
      "to": "estado"
    },
    {
      "id": "estado-update",
      "from": "estado",
      "to": "update_call"
    },
    {
      "id": "update-patch",
      "from": "update_call",
      "to": "api_estado",
      "label": "PATCH /api/v1/packages/{id}/status",
      "variant": "emphasis"
    },
    {
      "id": "update-reply",
      "from": "api_estado",
      "to": "entregado",
      "label": "confirmado",
      "variant": "emphasis",
      "role": "return"
    },
    {
      "id": "entrega-rastreo",
      "from": "entregado",
      "to": "track_call",
      "label": "consulta seguimiento"
    },
    {
      "id": "track-fetch",
      "from": "track_call",
      "to": "fetch_call"
    },
    {
      "id": "fetch-get",
      "from": "fetch_call",
      "to": "api_track",
      "label": "GET /api/v1/tracking/{code}",
      "variant": "emphasis"
    },
    {
      "id": "fetch-mock",
      "from": "fetch_call",
      "to": "mock",
      "label": "sin conexión",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "mock-reply",
      "from": "mock",
      "to": "followup",
      "label": "detalle local",
      "variant": "dashed",
      "role": "return"
    },
    {
      "id": "track-reply",
      "from": "api_track",
      "to": "followup",
      "label": "200 detalle + eventos",
      "variant": "emphasis",
      "role": "return"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Ruta principal",
      "items": [
        "La guía nace en el panel y avanza por estados hasta entregada",
        "Cada operación intenta la API REST real en :8080",
        "El cliente consulta la misma guía por el rastreo público"
      ]
    },
    {
      "dot": "rose",
      "title": "Respaldo sin conexión",
      "items": [
        "trackingService intenta REST y cae a las guías locales",
        "Los datos mock simulan latencia para parecer producción",
        "auth y packages repiten el mismo patrón try/catch"
      ]
    },
    {
      "dot": "cyan",
      "title": "Estados del envío",
      "items": [
        "REGISTRADO → EN_ALMACÉN → EN_TRÁNSITO → EN_RUTA → ENTREGADO",
        "INCIDENCIA se marca como estado alterno del operador",
        "Cada actualización guarda ubicación y notas del despacho"
      ]
    }
  ]
}