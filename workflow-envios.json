{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Registro y rastreo de envíos — SwiftLogix",
    "output": "workflow-envios.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "registro-del-envio",
        "label": "Registro del envío",
        "focus": [
          "crear",
          "create_call",
          "api_crear",
          "guia",
          "estado",
          "update_call",
          "api_estado",
          "entregado"
        ],
        "note": "La guía nace en el panel y avanza hasta la entrega confirmada."
      },
      {
        "id": "rastreo-publico",
        "label": "Rastreo público",
        "focus": [
          "entregado",
          "track_call",
          "fetch_call",
          "api_track",
          "followup"
        ],
        "note": "El cliente consulta la misma guía desde la web."
      },
      {
        "id": "respaldo-offline",
        "label": "Respaldo offline",
        "focus": [
          "fetch_call",
          "api_track",
          "mock",
          "followup"
        ],
        "note": "Cuando la red falla, trackingService lee las guías locales."
      }
    ]
  },
  "lanes": [
    {
      "id": "panel",
      "label": "Panel Operativo"
    },
    {
      "id": "web",
      "label": "Web de Rastreo"
    },
    {
      "id": "servicios",
      "label": "Capa de Servicios"
    },
    {
      "id": "api",
      "label": "API Central"
    },
    {
      "id": "fallback",
      "label": "Respaldo local",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "registro",
      "label": "Registro del envío",
      "fromCol": 0,
      "toCol": 1,
      "variant": "emphasis"
    },
    {
      "id": "logistica",
      "label": "Logística",
      "fromCol": 2,
      "toCol": 3
    },
    {
      "id": "rastreo",
      "label": "Rastreo",
      "fromCol": 4,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "groups": [
    {
      "id": "operacion",
      "label": "Operación",
      "lane": "panel",
      "fromCol": 0,
      "toCol": 3,
      "variant": "default"
    }
  ],
  "mainPath": [
    "crear",
    "create_call",
    "api_crear",
    "guia",
    "estado",
    "update_call",
    "api_estado",
    "entregado",
    "track_call",
    "fetch_call",
    "api_track",
    "followup"
