    {
      "id": "create_call",
      "lane": "servicios",
      "col": 0,
      "type": "backend",
      "label": "packageService",
      "sublabel": "create(dto)",
      "width": 132
    },
    {
      "id": "api_crear",
      "lane": "api",
      "col": 0,
      "type": "cloud",
      "label": "API Envíos",
      "sublabel": "crea la guía",
      "width": 132
    },
    {
      "id": "guia",
      "lane": "panel",
      "col": 1,
      "type": "frontend",
      "label": "Guía emitida",
      "sublabel": "código SW-XXXX-XX",
      "width": 132
    },
    {
      "id": "estado",
      "lane": "panel",
      "col": 2,
      "type": "frontend",
      "label": "Ciclo de estados",
      "sublabel": "EN_ALMACÉN → EN_RUTA",
      "width": 150
    },
    {
      "id": "update_call",
      "lane": "servicios",
      "col": 2,
      "type": "backend",
      "label": "packageService",
      "sublabel": "updateStatus(dto)",
      "width": 132
    },
    {
      "id": "api_estado",
      "lane": "api",
      "col": 2,
      "type": "cloud",
      "label": "API Envíos",
      "sublabel": "actualiza físico",
      "width": 132
    },
    {
      "id": "entregado",
      "lane": "panel",
      "col": 3,
      "type": "frontend",
      "label": "Entrega confirmada",
      "sublabel": "ENTREGADO + firma",
      "width": 132
    },
    {
      "id": "track_call",
      "lane": "web",
      "col": 4,
      "type": "frontend",
      "label": "Rastreo público",
      "sublabel": "ingresa código de guía",
      "width": 150
    },
    {
      "id": "fetch_call",
      "lane": "servicios",
      "col": 4,
