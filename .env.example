# =============================================================================
# ENVIRONMENT VARIABLES: FRONTEND (HerramientasFront)
# Set NEXT_PUBLIC_API_URL to point to your Spring Boot REST API deployed on Render
# (e.g. https://nexora-backend.onrender.com/api or http://localhost:8080/api)
# =============================================================================

NEXT_PUBLIC_API_URL=https://nexora-backend.onrender.com/api

# Google OAuth2 client ID (público; el mismo configurado en el backend)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Facebook Login: Client ID (público; es el "App ID" de Meta, el mismo valor que
# FACEBOOK_CLIENT_ID en el backend). El Client Secret NUNCA va aquí: es del backend.
NEXT_PUBLIC_FACEBOOK_CLIENT_ID=your_facebook_app_id
# Versión de la Graph API; debe coincidir con FACEBOOK_API_VERSION del backend.
NEXT_PUBLIC_FACEBOOK_API_VERSION=v26.0
